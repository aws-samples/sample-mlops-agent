# Local-only working docs — the entire docs/ tree (plans, QA records, security
# scanner output, reference notes) stays out of the shared repo. Previously
# tracked files were untracked with `git rm -r --cached docs/`; they remain on
# disk locally and recoverable from git history.
docs/

